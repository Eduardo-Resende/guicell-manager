# ─── Modelo de variáveis de ambiente para PRODUÇÃO ────────────────────────────
# Copie este arquivo para .env no VPS e preencha os valores reais.
# NUNCA commite o arquivo .env com senhas reais!

# Servidor
PORT=3001
NODE_ENV=production
TRUST_PROXY=loopback

# Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=guicell_manager
DB_USER=guicell_app
DB_PASS=TROQUE_PELA_SENHA_DO_BANCO

# Autenticação JWT e Segredos
JWT_SECRET=TROQUE_POR_UM_SECRET_LONGO_E_ALEATORIO_COM_ALTA_ENTROPIA
JWT_EXPIRES_IN=8h
RESET_OTP_HMAC_KEY=CHAVE_SECRETA_DEDICADA_HMAC_OTP_MINIMO_256_BITS

# CORS — URL do frontend (IP ou domínio)
FRONTEND_URL=http://179.197.228.65

# Configurações de E-mail (SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=seu-email@seudominio.com.br
SMTP_PASS=sua_senha_aqui

# Configurações do WhatsApp (Evolution API)
WHATSAPP_API_URL=https://api-whatsapp.seudominio.com
WHATSAPP_API_KEY=sua_apikey_aqui
WHATSAPP_INSTANCE=nome_da_instancia

# Caixa: diferença de conferência (abertura/fechamento), em R$, acima da qual é exigida
# autorização de um usuário com a permissão caixa.aprovar. Padrão: 10.00
CAIXA_LIMITE_DIVERGENCIA=10.00
